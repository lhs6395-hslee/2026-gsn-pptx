{
  "_comment": "slide15.xml (3-item 레이아웃) 전용 설정",
  "description": "3개 항목 레이아웃 — 각 항목은 제목 2줄 + 설명 2줄 + 이미지 슬롯 구조",

  "image_slot_format": "[이미지: {description}]",
  "_image_slot_comment": "이미지 슬롯 텍스트 포맷. {description}은 plan.json의 image_desc로 채워짐",

  "numbering": {
    "subtitle_prefix": "{n:02d}",
    "_subtitle_comment": "subtitle 앞 번호. {n}은 챕터 번호",
    "item_title_prefix": "{n:02d}",
    "_item_title_comment": "item_titles 1번째 줄 앞에 붙을 번호. {n}은 1,2,3...",
    "body_title_prefix": "{major}.{minor}.",
    "_body_title_comment": "body_title 앞 번호. {major}=챕터, {minor}=섹션",
    "sub_heading_prefix": "| {major}.{minor}.{sub}",
    "_sub_heading_comment": "sub_heading 앞 번호"
  },

  "text_structure": {
    "item_title_lines": 2,
    "_item_title_comment": "item_titles는 2줄 구조: 1줄=번호+제목(bold), 2줄=짧은 설명",
    "item_desc_lines": 1,
    "_item_desc_comment": "item_descs는 1줄 구조: 상세 설명 (2번째 para는 빈 줄)"
  },

  "zone_map_override": {
    "_comment": "layout_zone_map.json의 slide15 항목을 오버라이드하는 규칙",
    "item_titles": {
      "line1_bold": true,
      "_line1_comment": "1번째 줄은 bold 유지"
    },
    "image_slots": {
      "font": "맑은 고딕",
      "color": "3C41E6",
      "size": 1200,
      "align": "ctr"
    }
  },

  "plan_json_schema": {
