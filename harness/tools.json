{
  "version": "0.0",
  "tools": {
    "xml_edit": {
      "description": "slide XML의 텍스트 노드를 교체한다",
      "allowed_ops": ["str_replace"],
      "post_hook": "et_parse_validate",
      "notes": ""
    },
    "unpack": {
      "description": "pptx를 unpacked/ 디렉토리로 압축 해제",
      "command": "python scripts/office/unpack.py <template> unpacked/",
      "notes": ""
    },
    "pack": {
      "description": "unpacked/ 디렉토리를 .pptx로 패킹",
      "command": "python scripts/office/pack.py unpacked/ output.pptx --original <template>",
      "notes": ""
    },
    "clean": {
      "description": "고아 슬라이드·미디어 정리",
      "command": "python scripts/clean.py unpacked/",
      "notes": ""
    },
    "thumbnail": {
      "description": "템플릿 슬라이드 썸네일 그리드 생성",
      "command": "python scripts/thumbnail.py <template> thumbs",
      "notes": ""
    },
    "visual_qa": {
      "description": "슬라이드를 이미지로 변환하고 LLM이 검수",
      "command": "python scripts/office/soffice.py --headless --convert-to pdf output.pptx && pdftoppm -jpeg -r 150 output.pdf slide",
      "notes": ""
    },
    "content_check": {
      "description": "플레이스홀더 잔여 검사",
      "command": "extract-text output.pptx | grep -iE 'lorem|작성해주세요|TODO|\\[insert'",
      "notes": ""
    }
  }
}
